{
  "expo": {
    "name": "Citizen Centric",
    "slug": "citizen-centric-participant-staging",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/citizen-centric-app-icon.png",
    "scheme": "pcip-participant",
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7faf8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.politis.pcip.participant.staging",
      "associatedDomains": [
        "applinks:participant.staging.politis.co.uk"
      ]
    },
    "android": {
      "package": "uk.politis.pcip.participant.staging",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "participant.staging.politis.co.uk",
              "pathPrefix": "/join-study"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
