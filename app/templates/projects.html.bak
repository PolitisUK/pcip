{% extends "base.html" %}{% block title %}Projects{% endblock %}{% block content %}
{% if can_edit %}<div class="card"><h2>Create project</h2><form method="post" action="/projects" class="stack"><div class="row"><div class="field"><label>Title</label><input name="title" required></div><div class="field small"><label>Code</label><input name="code" required placeholder="TCX-001"></div><div class="field small"><label>Status</label><select name="status_value">{% for s in statuses %}<option>{{ s }}</option>{% endfor %}</select></div></div><div class="field"><label>Description</label><textarea name="description" rows="3"></textarea></div><div><button>Create project</button></div></form></div>{% endif %}
<div class="card section"><h2>Projects</h2><table class="table"><thead><tr><th>Project</th><th>Studies</th><th>Status</th><th>Updated</th></tr></thead><tbody>{% for p in projects %}<tr><td><a href="/projects/{{ p.id }}"><strong>{{ p.title }}</strong></a><br><span class="muted">{{ p.code }}</span></td><td>{{ counts.get(p.id,0) }}</td><td><span class="badge {{ p.status }}">{{ p.status|title }}</span></td><td>{{ p.updated_at.strftime('%d %b %Y') }}</td></tr>{% else %}<tr><td colspan="4" class="empty">No projects have been created.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
