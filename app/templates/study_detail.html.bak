{% extends "base.html" %}{% block title %}{{ study.title }}{% endblock %}{% block content %}
<div class="card"><div class="section-head"><div><p class="muted"><a href="/projects/{{ project.id }}">{{ project.title }}</a> · {{ study.code }}</p><p>{{ study.description or 'No study description supplied.' }}</p><span class="badge {{ study.status }}">{{ study.status|title }}</span> <span class="badge">{{ study.methodology|replace('_',' ')|title }}</span></div></div>
{% if can_edit %}<details class="section"><summary><strong>Edit study settings</strong></summary><form method="post" action="/studies/{{ study.id }}/edit" class="stack section"><div class="row"><div class="field"><label>Title</label><input name="title" value="{{ study.title }}" required></div><div class="field"><label>Method</label><select name="methodology">{% for m in ['diary','walk_along','interview','focus_group','co_design','mixed_method'] %}<option value="{{ m }}" {% if m==study.methodology %}selected{% endif %}>{{ m|replace('_',' ')|title }}</option>{% endfor %}</select></div><div class="field"><label>Status</label><select name="status_value">{% for x in ['draft','recruiting','live','paused','closed'] %}<option {% if x==study.status %}selected{% endif %}>{{ x }}</option>{% endfor %}</select></div></div><div class="field"><label>Description</label><textarea name="description">{{ study.description }}</textarea></div><div class="field"><label>Demographic questions (one per line)</label><textarea name="demographics_schema">{{ study.demographics_schema_json|replace('[','')|replace(']','')|replace('\"','')|replace(',','\n') }}</textarea><small class="muted">Used to define the demographic fields collected for this study.</small></div><button>Save study</button></form></details>{% endif %}</div>
<div class="card section" id="team-access"><div class="section-head"><div><h2>Study access</h2><p class="muted">Assign view or edit access to individual team members. Owners and administrators always retain management access.</p></div><span class="badge">Your access: {{ study_permission|title }}</span></div>{% if user.role in ['owner','admin'] %}<table class="table"><thead><tr><th>Team member</th><th>Organisation role</th><th>Study permission</th><th>Save</th></tr></thead><tbody>{% for member in team %}<tr><td>{{ member.name }}<br><span class="muted">{{ member.email }}</span></td><td>{{ member.role|title }}</td><td>{% if member.role in ['owner','admin'] %}<span class="badge">Manage</span>{% else %}<form method="post" action="/studies/{{ study.id }}/access" class="inline"><input type="hidden" name="user_id" value="{{ member.id }}"><label class="sr-only" for="permission-{{ member.id }}">Permission for {{ member.name }}</label><select id="permission-{{ member.id }}" name="permission"><option value="none" {% if not access_map.get(member.id) %}selected{% endif %}>No explicit access</option><option value="view" {% if access_map.get(member.id) and access_map[member.id].permission=='view' %}selected{% endif %}>View</option><option value="edit" {% if access_map.get(member.id) and access_map[member.id].permission=='edit' %}selected{% endif %}>Edit</option></select></td><td><button class="mini">Save</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Access assignments are managed by an owner or administrator.</p>{% endif %}</div><div class="two-col section">{% if can_edit %}<div class="card"><h2>Activity builder</h2><form method="post" action="/studies/{{ study.id }}/activities" class="stack"><div class="field"><label>Activity title</label><input name="title" required></div><div class="field"><label>Participant prompt</label><textarea name="prompt" rows="3"></textarea></div><div class="row"><div class="field"><label>Response type</label><select name="activity_type">{% for t in activity_types %}<option value="{{ t }}">{{ t|replace('_',' ')|title }}</option>{% endfor %}</select></div><div class="field small"><label>Release day</label><input type="number" min="0" name="release_offset_days" value="0"></div><div class="field small"><label>Due day</label><input type="number" min="0" name="due_offset_days"></div></div><div class="field"><label>Choice options (one per line)</label><textarea name="options" rows="3"></textarea></div><label class="check"><input type="checkbox" name="required" value="true" checked> Required</label><button>Add activity</button></form></div>{% endif %}
<div class="card"><h2>Activities</h2>{% for a in activities %}<details class="activity"><summary><strong>{{ a.position }}. {{ a.title }}</strong> <span class="badge">{{ response_counts.get(a.id,0) }} submissions</span></summary><p>{{ a.prompt }}</p><p class="muted">{{ a.activity_type|replace('_',' ')|title }} · release day {{ a.release_offset_days }}{% if a.due_offset_days is not none %} · due day {{ a.due_offset_days }}{% endif %}</p>{% if can_edit %}<form method="post" action="/activities/{{ a.id }}/edit" class="stack"><div class="field"><label>Title</label><input name="title" value="{{ a.title }}"></div><div class="field"><label>Prompt</label><textarea name="prompt">{{ a.prompt }}</textarea></div><div class="row"><div class="field"><label>Type</label><select name="activity_type">{% for t in activity_types %}<option value="{{ t }}" {% if t==a.activity_type %}selected{% endif %}>{{ t|replace('_',' ')|title }}</option>{% endfor %}</select></div><div class="field"><label>Release day</label><input type="number" name="release_offset_days" value="{{ a.release_offset_days }}"></div><div class="field"><label>Due day</label><input type="number" name="due_offset_days" value="{{ a.due_offset_days if a.due_offset_days is not none else '' }}"></div></div><div class="field"><label>Options</label><textarea name="options">{{ a.options_json|replace('[','')|replace(']','')|replace('\"','')|replace(',','\n') }}</textarea></div><label class="check"><input type="checkbox" name="required" value="true" {% if a.required %}checked{% endif %}> Required</label><div class="inline"><button>Save</button></form><form method="post" action="/activities/{{ a.id }}/delete"><button class="danger" data-confirm="Delete this activity and its responses?">Delete</button></form></div>{% endif %}</details>{% else %}<p class="empty">No activities yet.</p>{% endfor %}</div></div>
<div class="two-col section">{% if can_edit %}<div class="card"><h2>Enrol participant</h2>{% if available %}<form method="post" action="/studies/{{ study.id }}/enrol" class="row"><div class="field"><select name="participant_id">{% for p in available %}<option value="{{ p.id }}">{{ p.reference }} · {{ p.name }}</option>{% endfor %}</select></div><button>Enrol</button></form>{% else %}<p class="muted">All participants are enrolled.</p>{% endif %}</div>{% endif %}<div class="card"><h2>Recruitment summary</h2><div class="metric">{{ enrolments|length }}</div><p class="muted">Enrolled participants</p></div></div>
<div class="card section"><h2>Enrolled participants</h2><table class="table"><thead><tr><th>Participant</th><th>Consent</th><th>Invitation</th><th>Controls</th></tr></thead><tbody>{% for e in enrolments %}{% set p=participants[e.participant_id] %}{% set i=latest_invites.get(p.id) %}<tr><td><a href="/participants/{{ p.id }}"><strong>{{ p.name }}</strong></a><br><span class="muted">{{ p.reference }}</span></td><td><span class="badge {{ p.consent_status }}">{{ p.consent_status|title }}</span></td><td>{% if i and i.accepted_at %}Accepted{% elif i and i.revoked_at %}Revoked{% elif i %}Pending{% else %}Not sent{% endif %}</td><td>{% if can_edit and p.email %}{% if i and not i.accepted_at and not i.revoked_at %}<div class="inline"><form method="post" action="/participant-invitations/{{ i.id }}/resend"><button class="mini">Resend</button></form><form method="post" action="/participant-invitations/{{ i.id }}/revoke"><button class="mini danger" data-confirm="Revoke this link?">Revoke</button></form></div>{% else %}<form method="post" action="/studies/{{ study.id }}/invite/{{ p.id }}"><button class="mini">Email invitation</button></form>{% endif %}{% else %}<span class="muted">Unavailable</span>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="empty">No participants enrolled.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
