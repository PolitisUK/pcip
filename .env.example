APP_NAME=Citizen Centric
# Development only. Hosted environments must set a long random secret (>=32 chars).
SECRET_KEY=__DEVELOPMENT_ONLY_REPLACE_WITH_LONG_RANDOM_SECRET_FOR_HOSTED_ENV__
DATABASE_URL=sqlite:///./data/app.db
BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.org
SMTP_USE_TLS=true
# Development default. Hosted environments must set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Development default. Hosted environments must set SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false

# Lightweight abuse protection (tuned to avoid impacting normal users)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_IP=500
RATE_LIMIT_LOGIN_ACCOUNT=200
RATE_LIMIT_FORGOT_PASSWORD_IP=200
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT=60
RATE_LIMIT_PASSWORD_RESET_IP=200
RATE_LIMIT_PASSWORD_RESET_TOKEN=60
RATE_LIMIT_INVITATION_ACCEPT_IP=200
RATE_LIMIT_INVITATION_ACCEPT_TOKEN=60
RATE_LIMIT_PORTAL_WRITE_IP=600
RATE_LIMIT_PORTAL_WRITE_TOKEN=200

# Enterprise foundation
# Development defaults only. Hosted environments must use explicit public hosts.
TRUSTED_HOSTS=127.0.0.1,localhost
# Development defaults only. Hosted environments must use explicit HTTPS origins.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp3,.wav,.m4a,.mp4,.mov,.pdf,.doc,.docx,.txt,.csv
LOCAL_STORAGE_PATH=./data/uploads
# Optional ClamAV daemon
CLAMAV_HOST=
CLAMAV_PORT=3310

# Azure-native evidence storage (recommended for hosted environments)
# Set STORAGE_BACKEND=azure_blob in Azure App Service. DefaultAzureCredential will use
# the App Service managed identity. A connection string is supported for local development only.
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence
# Hosted environments must set a non-empty shared secret for Defender webhook authentication.
AZURE_DEFENDER_WEBHOOK_SECRET=
DEFENDER_REQUIRE_CLEAN_DOWNLOAD=true
# Development-only optional bypass. Keep false in hosted environments.
DEVELOPMENT_ALLOW_UNSCANNED_DOWNLOADS=false
AZURE_SAS_MINUTES=5

# Hosted environment and Microsoft Entra ID
ENVIRONMENT=development
# Must be false in every hosted environment.
SEED_DEMO_DATA=true
LOCAL_LOGIN_ENABLED=true
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DEFAULT_ORGANISATION_SLUG=
ENTRA_ALLOWED_DOMAINS=
ENTRA_AUTO_PROVISION=false
ENTRA_DEFAULT_ROLE=researcher
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Research Intelligence. Off by default; use Key Vault for AZURE_OPENAI_API_KEY.
RESEARCH_INTELLIGENCE_ENABLED=false
RESEARCH_INTELLIGENCE_AI_CODING_ENABLED=false
RESEARCH_INTELLIGENCE_SEMANTIC_SEARCH_ENABLED=false
RESEARCH_INTELLIGENCE_EVIDENCE_CONFIDENCE_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=qual-coder
KEY_VAULT_SECRET_AZURE_OPENAI_API_KEY=azure-openai-api-key

# Privacy lifecycle controls (technical implementation only)
PRIVACY_RETENTION_DAYS=365
PRIVACY_RETENTION_STATUSES=withdrawn,completed
PRIVACY_RETENTION_ACTION=anonymise
