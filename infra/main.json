{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "15000472380502650245"
    }
  },
  "parameters": {
    "prefix": {
      "type": "string",
      "defaultValue": "pcip"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "dev"
    },
    "containerImageTag": {
      "type": "string",
      "defaultValue": "0.6.0"
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1"
    },
    "postgresSku": {
      "type": "string",
      "defaultValue": "Standard_B1ms"
    },
    "postgresTier": {
      "type": "string",
      "defaultValue": "Burstable"
    },
    "postgresVersion": {
      "type": "string",
      "defaultValue": "16"
    },
    "postgresAdminUser": {
      "type": "string",
      "defaultValue": "pcipadmin"
    },
    "postgresAdminPassword": {
      "type": "securestring"
    },
    "secretKey": {
      "type": "securestring"
    },
    "defenderWebhookSecret": {
      "type": "securestring"
    },
    "entraClientSecret": {
      "type": "securestring",
      "defaultValue": ""
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": ""
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": ""
    },
    "entraAllowedDomains": {
      "type": "string",
      "defaultValue": ""
    },
    "entraDefaultOrganisationSlug": {
      "type": "string",
      "defaultValue": ""
    },
    "defenderMonthlyScanCapGB": {
      "type": "int",
      "defaultValue": 500
    }
  },
  "variables": {
    "suffix": "[uniqueString(subscription().subscriptionId, resourceGroup().id, parameters('prefix'), parameters('environmentName'))]",
    "compact": "[toLower(replace(format('{0}{1}{2}', parameters('prefix'), parameters('environmentName'), take(variables('suffix'), 8)), '-', ''))]",
    "storageName": "[take(format('{0}st', variables('compact')), 24)]",
    "registryName": "[take(format('{0}acr', variables('compact')), 50)]",
    "appName": "[format('{0}-{1}-{2}', parameters('prefix'), parameters('environmentName'), take(variables('suffix'), 6))]",
    "appHostName": "[format('{0}.azurewebsites.net', variables('appName'))]",
    "planName": "[format('{0}-plan', variables('appName'))]",
    "insightsName": "[format('{0}-appi', variables('appName'))]",
    "logName": "[format('{0}-log', variables('appName'))]",
    "vaultName": "[take(format('{0}-{1}-{2}-kv', parameters('prefix'), parameters('environmentName'), take(variables('suffix'), 6)), 24)]",
    "postgresName": "[take(format('{0}-{1}-{2}-pg', parameters('prefix'), parameters('environmentName'), take(variables('suffix'), 8)), 63)]",
    "databaseName": "pcip",
    "databaseUrl": "[format('postgresql+psycopg://{0}:{1}@{2}.postgres.database.azure.com:5432/{3}?sslmode=require', parameters('postgresAdminUser'), uriComponent(parameters('postgresAdminPassword')), variables('postgresName'), variables('databaseName'))]",
    "imageName": "[format('{0}.azurecr.io/pcip:{1}', variables('registryName'), parameters('containerImageTag'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logName')]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('insightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-11-01-preview",
      "name": "[variables('registryName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_ZRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', 'evidence')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Security/defenderForStorageSettings",
      "apiVersion": "2025-06-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "current",
      "properties": {
        "isEnabled": true,
        "overrideSubscriptionLevelSettings": true,
        "malwareScanning": {
          "blobScanResultsOptions": "blobIndexTags",
          "onUpload": {
            "isEnabled": true,
            "capGBPerMonth": "[parameters('defenderMonthlyScanCapGB')]"
          }
        },
        "sensitiveDataDiscovery": {
          "isEnabled": false
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('postgresName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('postgresSku')]",
        "tier": "[parameters('postgresTier')]"
      },
      "properties": {
        "version": "[parameters('postgresVersion')]",
        "administratorLogin": "[parameters('postgresAdminUser')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 14,
          "geoRedundantBackup": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), variables('databaseName'))]",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('vaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[tenant().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 30,
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'database-url')]",
      "properties": {
        "value": "[variables('databaseUrl')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'session-secret')]",
      "properties": {
        "value": "[parameters('secretKey')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'defender-webhook-secret')]",
      "properties": {
        "value": "[parameters('defenderWebhookSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('entraClientSecret')))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'entra-client-secret')]",
      "properties": {
        "value": "[parameters('entraClientSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServiceSku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "[format('DOCKER|{0}', variables('imageName'))]",
          "acrUseManagedIdentityCreds": true,
          "alwaysOn": true,
          "healthCheckPath": "/health",
          "minimumElasticInstanceCount": 1,
          "appSettings": [
            {
              "name": "APP_NAME",
              "value": "Politis Civic Intelligence"
            },
            {
              "name": "ENVIRONMENT",
              "value": "[parameters('environmentName')]"
            },
            {
              "name": "SEED_DEMO_DATA",
              "value": "false"
            },
            {
              "name": "DATABASE_URL",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'database-url'), '2023-07-01').secretUriWithVersion)]"
            },
            {
              "name": "SECRET_KEY",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'session-secret'), '2023-07-01').secretUriWithVersion)]"
            },
            {
              "name": "BASE_URL",
              "value": "[format('https://{0}', variables('appHostName'))]"
            },
            {
              "name": "COOKIE_SECURE",
              "value": "true"
            },
            {
              "name": "TRUSTED_HOSTS",
              "value": "[variables('appHostName')]"
            },
            {
              "name": "ALLOWED_ORIGINS",
              "value": "[format('https://{0}', variables('appHostName'))]"
            },
            {
              "name": "STORAGE_BACKEND",
              "value": "azure_blob"
            },
            {
              "name": "AZURE_STORAGE_ACCOUNT_URL",
              "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
            },
            {
              "name": "AZURE_STORAGE_CONTAINER",
              "value": "evidence"
            },
            {
              "name": "AZURE_DEFENDER_WEBHOOK_SECRET",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'defender-webhook-secret'), '2023-07-01').secretUriWithVersion)]"
            },
            {
              "name": "DEFENDER_REQUIRE_CLEAN_DOWNLOAD",
              "value": "true"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "WEBSITES_PORT",
              "value": "8000"
            },
            {
              "name": "RUN_MIGRATIONS",
              "value": "true"
            },
            {
              "name": "ENTRA_ENABLED",
              "value": "[string(not(empty(parameters('entraClientId'))))]"
            },
            {
              "name": "ENTRA_TENANT_ID",
              "value": "[parameters('entraTenantId')]"
            },
            {
              "name": "ENTRA_CLIENT_ID",
              "value": "[parameters('entraClientId')]"
            },
            {
              "name": "ENTRA_CLIENT_SECRET",
              "value": "[if(empty(parameters('entraClientSecret')), '', format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'entra-client-secret'), '2023-07-01').secretUriWithVersion))]"
            },
            {
              "name": "ENTRA_ALLOWED_DOMAINS",
              "value": "[parameters('entraAllowedDomains')]"
            },
            {
              "name": "ENTRA_DEFAULT_ORGANISATION_SLUG",
              "value": "[parameters('entraDefaultOrganisationSlug')]"
            },
            {
              "name": "ENTRA_AUTO_PROVISION",
              "value": "false"
            },
            {
              "name": "LOCAL_LOGIN_ENABLED",
              "value": "true"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', variables('postgresName'), 'AllowAzureServices')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'database-url')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'entra-client-secret')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageName'), 'default', 'evidence')]",
        "[resourceId('Microsoft.Insights/components', variables('insightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('postgresName'), variables('databaseName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'session-secret')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'defender-webhook-secret')]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.Web/sites', variables('appName')), 'blob-contributor')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('appName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.Web/sites', variables('appName')), 'acr-pull')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('appName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), resourceId('Microsoft.Web/sites', variables('appName')), 'secrets-user')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[format('https://{0}', variables('appHostName'))]"
    },
    "appName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "registryName": {
      "type": "string",
      "value": "[variables('registryName')]"
    },
    "registryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-11-01-preview').loginServer]"
    },
    "postgresServerName": {
      "type": "string",
      "value": "[variables('postgresName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('vaultName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "entraRedirectUri": {
      "type": "string",
      "value": "[format('https://{0}/auth/entra/callback', variables('appHostName'))]"
    }
  }
}